# Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# MongoDB Configuration
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_ROUTER_PORT=27017
MONGO_SHARD1_PORT=27018
MONGO_SHARD2_PORT=27019
MONGO_DB_NAME=cyber_intel
MONGO_LOGS_COLLECTION=network_logs
MONGO_ATTACK_STATS_COLLECTION=attack_stats
MONGO_IP_REPUTATION_COLLECTION=ip_reputation

# Hadoop HDFS Configuration
HDFS_NAMENODE_HOST=localhost
HDFS_NAMENODE_PORT=9000
HDFS_BASE_DIR=/cybersecurity

# Apache Spark Configuration
SPARK_MASTER_HOST=localhost
SPARK_MASTER_PORT=7077
SPARK_APP_NAME=CyberThreatAnalytics
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# Application Data Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
